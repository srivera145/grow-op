# Copy this file to .env and fill it in. .env is gitignored and must stay that way: it holds a key.
#
# These are read by the Vite dev server, in vite.config.js, and by nothing else. They are deliberately
# not VITE_ prefixed - that prefix is what puts a variable into the browser bundle, and an API key in a
# browser bundle is an API key on the internet. The editor's Generate panel posts a description to
# /api/generate-level and gets a layout back; the key never leaves the machine running the dev server.
#
# Both are only needed to generate levels in the editor. The game builds, runs and plays without them.
# Restart the dev server after changing either: .env is read when the server starts.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Which model writes the levels. There is no default: an unset model fails with a message naming this
# variable rather than guessing one, because a guess is a bill for a reply in the wrong shape.
ANTHROPIC_MODEL=claude-opus-5
