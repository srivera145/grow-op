# Copy this file to .env and fill it in. .env is gitignored and must stay that way: it holds keys.
#
# These are read by the Vite dev server, in vite.config.js, and by nothing else. They are deliberately
# not VITE_ prefixed - that prefix is what puts a variable into the browser bundle, and an API key in a
# browser bundle is an API key on the internet. The editor's panels post a description to a dev-server
# route and get a layout or a picture back; the keys never leave the machine running the dev server.
#
# All four are only needed to generate things in the editor. The game builds, runs and plays without
# any of them. Restart the dev server after changing any: .env is read when the server starts.

# ---------------------------------------------------------------- generating levels

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Which model writes the levels. There is no default: an unset model fails with a message naming this
# variable rather than guessing one, because a guess is a bill for a reply in the wrong shape.
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------- generating art

# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Which model draws the art, for the editor's Art panel. No default, for the same reason as above.
#
# Note the spelling: MODEL. An earlier .env on this project had OPENAI_IMAGE_MODAL, which is nothing,
# and a variable that is nothing reads exactly like a variable that is unset. The route says so by
# name if it finds the misspelling and not the real one.
OPENAI_IMAGE_MODEL=gpt-image-1
